# ═══════════════════════════════════════════════════════
# Mietvertrag Generator — Environment Variables
# ═══════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values.
# All variables are optional — the app uses sensible
# fallbacks if they are not set.
#
# In Docker: pass these via docker-compose.yml under
# the `environment:` key (without the VITE_ prefix
# workaround — Vite reads them at BUILD TIME, so they
# must be passed as build args or baked in at build).
# See docker-compose.yml comments for details.
# ═══════════════════════════════════════════════════════

# ── ContentPilot branding ───────────────────────────────
VITE_CONTENTPILOT_URL=https://mycontentpilot.de
VITE_CONTENTPILOT_NAME=ContentPilot

# ── Product identity ────────────────────────────────────
VITE_PRODUCT_NAME=Mietvertrag Generator
VITE_PRODUCT_DOMAIN=mietvertrag.mycontentpilot.de

# ── Legal / footer links ────────────────────────────────
VITE_IMPRESSUM_URL=https://mycontentpilot.de/impressum
VITE_DATENSCHUTZ_URL=https://mycontentpilot.de/datenschutz
VITE_AGB_URL=https://mycontentpilot.de/agb
VITE_CONTACT_URL=https://mycontentpilot.de/kontakt

# ── Support ─────────────────────────────────────────────
VITE_SUPPORT_EMAIL=support@mycontentpilot.de
