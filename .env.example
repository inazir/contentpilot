# =============================================================

# ContentPilot Environment Configuration

# =============================================================

# Copy this file to:

#

# .env

#

# Then replace placeholder values with real credentials.

#

# Environment variables are the single source of configuration.

# Do not hardcode secrets in code.

# =============================================================

# =============================================================

# GLOBAL PUBLISHING MODE

# =============================================================

# disabled = publishing disabled completely

# mock     = simulate publishing without external API calls

# real     = perform real publishing

# =============================================================

PUBLISH_MODE=mock

# Maximum number of posts allowed during a single execution

MAX_POSTS_PER_RUN=5

# =============================================================

# SOCIAL TARGETS

# =============================================================

# Comma-separated list of configured publishing targets

# =============================================================

SOCIAL_TARGETS=gs_facebook_main

# -------------------------------------------------------------

# Target: GermanStudies Main Facebook Page

# -------------------------------------------------------------

SOCIAL__GS_FACEBOOK_MAIN__PLATFORM=facebook
SOCIAL__GS_FACEBOOK_MAIN__ENABLED=false
SOCIAL__GS_FACEBOOK_MAIN__PAGE_ID=your_page_id_here
SOCIAL__GS_FACEBOOK_MAIN__ACCESS_TOKEN=your_page_access_token_here
SOCIAL__GS_FACEBOOK_MAIN__NAME=GermanStudies Main Page

# -------------------------------------------------------------

# Example Additional Targets

# -------------------------------------------------------------

#

# SOCIAL_TARGETS=gs_facebook_main,gs_facebook_brand2,gs_instagram_main

#

# SOCIAL__GS_FACEBOOK_BRAND2__PLATFORM=facebook

# SOCIAL__GS_FACEBOOK_BRAND2__ENABLED=false

# SOCIAL__GS_FACEBOOK_BRAND2__PAGE_ID=your_second_page_id

# SOCIAL__GS_FACEBOOK_BRAND2__ACCESS_TOKEN=your_second_page_token

# SOCIAL__GS_FACEBOOK_BRAND2__NAME=GermanStudies Brand 2

#

# SOCIAL__GS_INSTAGRAM_MAIN__PLATFORM=instagram

# SOCIAL__GS_INSTAGRAM_MAIN__ENABLED=false

# SOCIAL__GS_INSTAGRAM_MAIN__PAGE_ID=your_instagram_account_id

# SOCIAL__GS_INSTAGRAM_MAIN__ACCESS_TOKEN=your_instagram_token

# SOCIAL__GS_INSTAGRAM_MAIN__NAME=GermanStudies Instagram

# =============================================================

# AI DEFAULTS

# =============================================================

# Applied when no module-specific override exists

# =============================================================

AI_DEFAULT_PROVIDER=deepseek
AI_DEFAULT_MODEL=deepseek-chat

AI_DEFAULT_FALLBACK_PROVIDER=anthropic
AI_DEFAULT_FALLBACK_MODEL=claude-haiku-4-5

AI_DEFAULT_MAX_TOKENS=1024
AI_DEFAULT_TEMPERATURE=0.7

# Retry configuration

AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=2

# =============================================================

# AI API KEYS

# =============================================================

ANTHROPIC_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# =============================================================

# DAILY NEWS MODULE

# =============================================================

DAILY_NEWS_TARGETS=gs_facebook_main

# -------------------------------------------------------------

# AI Overrides

# -------------------------------------------------------------

DAILY_NEWS_AI_PROVIDER=deepseek
DAILY_NEWS_AI_MODEL=deepseek-chat

DAILY_NEWS_AI_FALLBACK_PROVIDER=anthropic
DAILY_NEWS_AI_FALLBACK_MODEL=claude-haiku-4-5

DAILY_NEWS_AI_MAX_TOKENS=300
DAILY_NEWS_AI_TEMPERATURE=0.8

# -------------------------------------------------------------

# Pipeline Mode & WordPress Publishing

# -------------------------------------------------------------

# Pipeline mode:
#   draft   → fetch, deduplicate, summarize, log — DO NOT publish
#   publish → complete pipeline including publishing
DAILY_NEWS_MODE=draft

DAILY_NEWS_ENABLE_WORDPRESS=true
DAILY_NEWS_WORDPRESS_STATUS=draft

# -------------------------------------------------------------

# RSS Feeds (Daily News specific)

# -------------------------------------------------------------

# Comma-separated RSS feed URLs
# Leave empty to fall back to static topic generation
DAILY_NEWS_RSS_FEEDS=

# Maximum articles to process per run across all feeds
DAILY_NEWS_MAX_ARTICLES=5

# Per-feed network timeout in seconds
DAILY_NEWS_FEED_TIMEOUT=15

# =============================================================

# RSS INGESTION (Legacy — see DAILY_NEWS_RSS_* above)

# =============================================================

# Phase 7 RSS News Pipeline

# =============================================================

RSS_ENABLED=true
RSS_MAX_ARTICLES=10
RSS_FETCH_TIMEOUT=15

# Example:

#

# RSS_SOURCES=https://rss.cnn.com/rss/edition.rss,https://feeds.bbci.co.uk/news/rss.xml

#

# If your implementation uses environment-driven feed loading.

RSS_SOURCES=

# =============================================================

# SQLITE STORE

# =============================================================

STORE_DB_PATH=/app/data/db/contentpilot.db

# =============================================================

# RUNTIME

# =============================================================

RUNTIME_DB_PATH=/app/data/db/contentpilot.db

# System User Mapping for Volume Permissions
DOCKER_UID=1000
DOCKER_GID=1000
# =============================================================

# NOTIFICATIONS

# =============================================================

NOTIFY_ON_FAIL=false

# -------------------------------------------------------------

# Email Notifications

# -------------------------------------------------------------

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password

NOTIFY_EMAIL_TO=you@yourdomain.com

# -------------------------------------------------------------

# Telegram Notifications

# -------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================

# LOGGING

# =============================================================

LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_DIR=/app/data/logs

# =============================================================

# BACKUPS

# =============================================================

BACKUP_DIR=/app/data/backups
BACKUP_KEEP_DAYS=7

# =============================================================

# WORDPRESS

# =============================================================

# WordPress Application Password authentication

#

# Example:

# WORDPRESS_BASE_URL=https://example.com

#

# Do NOT include:

# /wp-admin

# /wp-json

#

# Only the site root URL.

# =============================================================

WORDPRESS_BASE_URL=https://yourdomain.com
WORDPRESS_USERNAME=your_wp_username
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# draft | publish

WORDPRESS_DEFAULT_STATUS=draft

WORDPRESS_TIMEOUT_SECONDS=30
WORDPRESS_MAX_RETRIES=3

PYTHONPATH=/app

# =============================================================
# MEDIA ASSET STORAGE (Phase 11A)
# =============================================================

# Root directory for generated content asset bundles
MEDIA_STORAGE_DIR=/app/data/media

# Set to false to disable all media asset generation
ENABLE_MEDIA_ASSETS=true

# =============================================================
# MEDIA GENERATION FEATURES (Phase 11B)
# =============================================================

# Enable featured image generation for WordPress posts
ENABLE_FEATURED_IMAGES=true

# Enable social media image generation
ENABLE_SOCIAL_IMAGES=true

# Apply branding overlay to generated media
MEDIA_BRANDING_ENABLED=true

# Enable advertisement insertion in media assets
MEDIA_ADS_ENABLED=true
# =============================================================
# MEDIA BRANDING (Phase 12B)
# =============================================================
# Visual brand overlay applied to all generated images.
# Layouts: A (editorial bands), B (modern card — default), C (gradient type)
# =============================================================

MEDIA_BRANDING_ENABLED=false

MEDIA_BRAND_NAME=GermanySupport.de
MEDIA_BRAND_TAGLINE=Your expat guide to Germany
MEDIA_BRAND_CTA=Read more at GermanySupport.de
MEDIA_BRAND_WEBSITE=https://germanysupport.de
MEDIA_BRAND_PRIMARY_COLOR=#0F172A
MEDIA_BRAND_ACCENT_COLOR=#38BDF8

# Optional: absolute path to PNG logo file inside the container
# Must be accessible by appuser (UID 1000) — store under /app/data/ or /app/shared/assets/
MEDIA_BRAND_LOGO_PATH=

# Layout template: A | B | C  (default: B)
MEDIA_BRAND_LAYOUT=B

# =============================================================
# PHASE 13B — Multi-Brand Configuration
# =============================================================

# Default brand (brand_id=1) — used as seed values and env fallback
DEFAULT_BRAND_NAME=GermanySupport
DEFAULT_BRAND_SLUG=germanysupport
DEFAULT_BRAND_WEBSITE=https://germanysupport.de

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_HEARTBEAT_SECONDS=60
SCHEDULER_MAX_RETRIES=3
DAILY_NEWS_SCHEDULE_HOURS=1

# Media storage root (brand slug is appended automatically)
# Results in: /app/data/media/<brand_slug>/YYYY/MM/DD/
MEDIA_STORAGE_DIR=/app/data/media
