[Unit]
Description=ContentPilot Webhook Receiver
Documentation=https://github.com/your-org/contentpilot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=deployer
WorkingDirectory=/home/deployer/repos/contentpilot
EnvironmentFile=/home/deployer/repos/contentpilot/.env
ExecStart=/bin/bash /home/deployer/repos/contentpilot/deploy/scripts/webhook-server.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
