# ============================================================
# Python cache files (IMPORTANT)
# ============================================================

__pycache__/
*.pyc
*.pyo
*.pyd

# Pytest / tooling caches (optional but recommended)
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# Existing rules (keep yours as-is)
# ============================================================

.env

# Ignore everything inside data/ directories
data/db/*
data/cache/*
data/logs/*

# But keep the directories themselves tracked by Git via their .gitkeep files
!data/db/.gitkeep
!data/cache/.gitkeep
!data/logs/.gitkeep
!data/locks/.gitkeep
!data/runtime/.gitkeep

