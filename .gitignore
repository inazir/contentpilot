# ============================================================
# Python cache files (IMPORTANT)
# ============================================================

__pycache__/
*.pyc
*.pyo
*.pyd

# Pytest / tooling caches (optional but recommended)
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# Existing rules (keep yours as-is)
# ============================================================

.env

# Ignore everything inside data/ directories
data/db/*
data/cache/*
data/logs/*
data/backups/*
data/media/*

# But keep the directories themselves tracked by Git via their .gitkeep files
!data/db/.gitkeep
!data/cache/.gitkeep
!data/logs/.gitkeep
!data/locks/.gitkeep
!data/runtime/.gitkeep
!data/backups/.gitkeep

# Local AI Agent plugins and skill configurations
.agents/
skills-lock.json
.clineignore
.clinerules.md
data/media/composed/*.jpg

# Additional frontend and build artifacts
frontend/dist/
frontend/wordpress/dist/
frontend/mietvertrag/dist/

# Database and runtime files
*.db
*.db.gz
data/runtime/

# Lock files (if needed)
data/locks/

# Mietvertrag frontend npm files
frontend/mietvertrag/node_modules
frontend/mietvertrag/dist/

# ============================================================
# Core Project Fixes (Matching actual repository layout)
# ============================================================

# Ignore the entire WordPress plugins directory entirely 
frontend/wordpress/wp-content/plugins/

# Ignore zip bundles inside your custom theme
frontend/wordpress/wp-content/themes/mycontentpilot-theme/*.zip

# System & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/